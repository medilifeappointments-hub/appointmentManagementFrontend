# Backend origin used by the Vite development and preview servers to proxy browser requests from `/api`.
# Do not include `/api` or a trailing slash. A normal static production build does not read this variable.
API_PROXY_TARGET=http://localhost:4000

# Public backend origin embedded into a static production build when frontend and backend use different domains.
# Do not include `/api` or a trailing slash. Leave blank locally to use Vite's development proxy.
VITE_API_BASE_URL=
